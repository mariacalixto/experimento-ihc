generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AutonomyLevel {
  LOW
  MEDIUM
  HIGH
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

model Participant {
  id              String    @id @default(cuid())
  participantCode String    @unique
  accessTokenHash String?   @unique
  consentedAt     DateTime?
  createdAt       DateTime  @default(now())

  sessions ExperimentalSession[]
}

model ExperimentalSession {
  id            String        @id @default(cuid())
  participantId String
  autonomyLevel AutonomyLevel
  orderIndex    Int
  runNumber     Int           @default(1)
  isTestRun     Boolean       @default(false)
  status        SessionStatus @default(IN_PROGRESS)
  startedAt     DateTime?     @default(now())
  finishedAt    DateTime?

  participant Participant             @relation(fields: [participantId], references: [id], onDelete: Cascade)
  actions     AgentAction[]
  responses   QuestionnaireResponse[]

  @@unique([participantId, runNumber, orderIndex])
  @@index([autonomyLevel])
}

model AgentAction {
  id                   String       @id @default(cuid())
  sessionId            String
  actionType           String
  description          String       @db.Text
  requiresConfirmation Boolean      @default(false)
  status               ActionStatus @default(PENDING)
  createdAt            DateTime     @default(now())
  resolvedAt           DateTime?

  session ExperimentalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@unique([sessionId, actionType])
}

model QuestionnaireResponse {
  id           String   @id @default(cuid())
  sessionId    String
  questionCode String
  likertValue  Int?
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  session ExperimentalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionCode])
  @@index([sessionId])
}
